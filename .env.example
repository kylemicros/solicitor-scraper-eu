# ===========================================
# ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env and fill in your actual values

# Application Environment
APP_ENV=<development|production>
APP_DEBUG=<true|false>
TIMEZONE=Europe/London

# Organization Branding
COMPANY_NAME=<your-organization-name>

# ===========================================
# ONEDRIVE CONFIGURATION (Required for production)
# ===========================================
# These credentials are used for OAuth2 authentication with Microsoft Graph API
# Get these from Azure Portal > App Registrations > Your App

AZURE_CLIENT_ID=<your-client-id-here>
AZURE_CLIENT_SECRET=<your-client-secret-here>
AZURE_TENANT_ID=<your-tenant-id-here|common>  # Use "common" for personal accounts
AZURE_ACCESS_TOKEN=<your-access-token-here>
AZURE_REFRESH_TOKEN=<your-refresh-token-here>

# OneDrive Drive ID (usually "me" for personal accounts)
AZURE_ONEDRIVE_DRIVE_ID=<your-onedrive-drive-id-here>

# OneDrive folder path where Excel files will be uploaded
ONEDRIVE_FOLDER_PATH=/Solicitors

# Optional: Specific folder item ID (if not provided, ONEDRIVE_FOLDER_PATH will be used)
# AZURE_ONEDRIVE_ITEM_ID=your-folder-item-id

# ===========================================
# SCRAPER CONFIGURATION
# ===========================================

# Legal Issue Filter - Set automatically by run-all-scrapers.sh
# Options: LIUPIN, LIUFAM, LIUMCP, LIUSWB, LIUPCW, etc.
LEGAL_ISSUE_FILTER=LIUMCP

# Checkpoint - Resume from specific location index (0-based)
LOCATION_START_INDEX=0

# Crawler limits and delays
MAX_REQUESTS_PER_CRAWL=3000
SEARCH_RADIUS=10
REQUEST_DELAY_MS=30000
REQUEST_DELAY_JITTER_MS=15000
REQUEST_TIMEOUT_MS=10000

# Anti-bot detection measures
REQUESTS_PER_SESSION=5
SESSION_ROTATION_DELAY_MS=60000

# Retry configuration
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_MS=1000

# ===========================================
# OPTIONAL CONFIGURATION
# ===========================================

# Logging (e.g., info, debug, error)
LOG_LEVEL=info

# Proxy (if needed)
USE_PROXY=false
# PROXY_URL=http://your-proxy-url
# PROXY_USERNAME=your-username
# PROXY_PASSWORD=your-password
